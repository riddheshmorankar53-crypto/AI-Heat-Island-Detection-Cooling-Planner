# Environment Variables for Urban Cooling Planner
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED=42

# Optional PostgreSQL + PostGIS (defaults to GeoPandas fallback if unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pune_cooling_planner
USE_POSTGIS=false

# Frontend Base URL (for CORS)
FRONTEND_URL=http://localhost:5173
